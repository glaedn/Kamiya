# Kamiya Render environment example
#
# Do not commit real secrets. Use this file as a copy/paste guide for
# Render Dashboard environment variables. The real values belong in Render,
# not in Git.

# Render sets PORT automatically for web services. Do not define PORT unless
# you are debugging a custom runtime.

# Node runtime behavior.
NODE_ENV=production
NODE_VERSION=22.16.0

# Required: Gemini API key for live intent routing.
# Set as a secret in Render Dashboard.
KAMIYA_GEMINI_API_KEY=

# Required: model identifier used by the Gemini adapter.
KAMIYA_GEMINI_MODEL=gemini-3.1-flash-lite

# Recommended: keep model calls bounded so chat clients receive fallback
# responses instead of hanging on transient model/API latency.
KAMIYA_AI_TIMEOUT_MS=3000

# Required: public or private URL for the Cerbanimo API.
# Example: https://cerbanimo-api.onrender.com
KAMIYA_CERBANIMO_API_URL=

# Required for real Cerbanimo mutations and authenticated reads.
# Set as a Render secret. Use a scoped service token or bot token when
# Cerbanimo supports one; until then use a short-lived backend-issued JWT.
KAMIYA_CERBANIMO_BEARER_TOKEN=

# Optional: repository/ref Kamiya may prefill for quality-check preparation.
# Use only a repository that Cerbanimo's quality-check executor is configured
# to run safely. Leave blank to require explicit user-supplied inputs.
KAMIYA_DEFAULT_QUALITY_CHECK_REPOSITORY=
KAMIYA_DEFAULT_QUALITY_CHECK_REF=main

# Required at build time: Cerbanimo frontend origin that hosts
# /auth/bridge/start and posts the Auth0 bridge result back to Kamiya.
# Example: https://cerbanimo.onrender.com
VITE_CERBANIMO_ORIGIN=

# Required at build time: Cerbanimo API base for user-scoped calls.
# Example: https://cerbanimo-api.onrender.com
VITE_CERBANIMO_API_BASE=

# Required after first Render deploy: set to Kamiya's external Render URL.
# Example: https://kamiya.onrender.com
KAMIYA_ALLOWED_ORIGIN=

# Optional future bot-adapter hardening. Keep false until signing is wired.
KAMIYA_REQUIRE_CHANNEL_SIGNATURES=false
