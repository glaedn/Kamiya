{
  "name": "kamiya",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./shared/sdk.ts"
  },
  "scripts": {
    "dev": "concurrently \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 0.0.0.0",
    "dev:api": "tsx watch server/index.ts",
    "start:e2e-fixture": "npm run build && tsx e2e/fixtures/start-e2e-fixture.ts",
    "start:real-stack-e2e": "tsx e2e/real-stack/start-real-stack.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "lint": "eslint .",
    "test:e2e": "npm run test:e2e:contract && npm run test:e2e:integration && npm run test:e2e:failure",
    "test:e2e:contract": "playwright test e2e/golden-conversation.contract.spec.ts",
    "test:e2e:integration": "playwright test -c playwright.real-stack.config.ts e2e/golden-conversation.integration.spec.ts",
    "test:e2e:failure": "playwright test -c playwright.real-stack.config.ts e2e/golden-conversation.failure.spec.ts",
    "test:e2e:headed": "playwright test -c playwright.real-stack.config.ts e2e/golden-conversation.integration.spec.ts --headed --project=chromium --grep=\"golden conversation\"",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "vite": "^7.0.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^17.7.0",
    "jsdom": "^25.0.1",
    "pg": "^8.22.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.9"
  }
}
