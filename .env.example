# Kamiya local development environment
#
# Copy this file to `.env` for local development:
#   cp .env.example .env
#
# `.env` and `.env.*` are ignored by Git. Do not commit real secrets.

# Local API port for `npm run dev:api`.
# Render injects PORT automatically, so you usually do not set this there.
PORT=4177

# Server-side Gemini key used by the intent router.
# Create one in Google AI Studio and paste it only into local `.env`
# or Render's secret environment variable UI.
KAMIYA_GEMINI_API_KEY=

# Gemini model used by Kamiya's model adapter.
# Keep this value unless you intentionally migrate models.
KAMIYA_GEMINI_MODEL=gemini-3.1-flash-lite

# Maximum time to wait for Gemini before falling back to deterministic local
# routing/planning. Keeps the chat UI from getting stuck if the model is slow.
KAMIYA_AI_TIMEOUT_MS=3000

# Brief server-side hydration interval used after a review becomes accepted or
# a settlement is retried. This is not a browser authority or a completion
# timeout; Cerbanimo remains the source of truth and refresh recovery is safe.
KAMIYA_SETTLEMENT_POLL_MS=1500

# Base URL for the Cerbanimo API Kamiya should consume.
# Local example: http://localhost:4000
# Production example: https://cerbanimo-api.onrender.com
KAMIYA_CERBANIMO_API_URL=http://localhost:4000

# Server-side bearer token for Cerbanimo API calls.
# For local development, create or copy a short-lived Cerbanimo JWT/API token
# from your Cerbanimo backend/auth tooling and paste it into your local `.env`.
# Never paste this value into the browser settings UI and never commit it.
KAMIYA_CERBANIMO_BEARER_TOKEN=

# Optional default repository/ref used when a user clicks "Review quality
# checks" from a task card. Leave blank to make Kamiya ask for explicit
# repository inputs instead of preparing a quality-check run automatically.
# Format repository as owner/name.
KAMIYA_DEFAULT_QUALITY_CHECK_REPOSITORY=
KAMIYA_DEFAULT_QUALITY_CHECK_REF=main

# Cerbanimo browser origin used for Auth0 bridge popup login.
# Local Cerbanimo frontend example: http://localhost:3000
VITE_CERBANIMO_ORIGIN=http://localhost:3000

# Cerbanimo API base used when Kamiya forwards the browser-issued Auth0 token
# through its own API bridge for user-scoped Cerbanimo calls.
VITE_CERBANIMO_API_BASE=http://localhost:4000

# Comma-separated browser origins allowed to call the Kamiya API.
# Local clients: Kamiya Vite on 5173 and Resonera web on 3000.
# Production should be your Render external URL, e.g. https://kamiya.onrender.com
KAMIYA_ALLOWED_ORIGIN=http://localhost:5173,http://localhost:3000

# Optional future hardening flag for Discord/Slack/Google Chat adapters.
# Leave false until channel signing verification is implemented.
KAMIYA_REQUIRE_CHANNEL_SIGNATURES=false
